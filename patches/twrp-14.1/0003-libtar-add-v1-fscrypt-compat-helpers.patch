From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:02 +0600
Subject: [PATCH] libtar: add Android 14 fscrypt v2 compatibility helpers

TeamWin libtar still calls fscrypt policy helpers that are no longer exported
by Android 14 vold. Samurai QPR2 selects policy v2, so provide local helpers
for struct fscrypt_policy_v2 and use the 16-byte v2 master-key identifier.

Android 14 vold already prefixes policy-type strings with the policy version
(2CE/2DE/2DK), so do not prepend fep->version a second time.
---
 libtar/append.c  | 13 +++++++------
 libtar/extract.c |  2 +-
 libtar/libtar.h  | 40 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 48 insertions(+), 7 deletions(-)

diff --git a/libtar/append.c b/libtar/append.c
index d25ac85..3bd7ee0 100644
--- a/libtar/append.c
+++ b/libtar/append.c
@@ -153,10 +153,9 @@ tar_append_file(TAR *t, const char *realname, const char *savename)
 			size = get_policy_size(t->th_buf.fep, false);
 			hex_size = get_policy_size(t->th_buf.fep, true);
 			descriptor = get_policy_descriptor(t->th_buf.fep);
-			char user_ce[4], user_de[4], system_de[4];
-			sprintf(user_ce,"%u%s", t->th_buf.fep->version, USER_CE_FSCRYPT_POLICY);
-			sprintf(user_de,"%u%s", t->th_buf.fep->version, USER_DE_FSCRYPT_POLICY);
-			sprintf(system_de,"%u%s", t->th_buf.fep->version, SYSTEM_DE_FSCRYPT_POLICY);
+			char user_ce[4] = USER_CE_FSCRYPT_POLICY;
+			char user_de[4] = USER_DE_FSCRYPT_POLICY;
+			char system_de[4] = SYSTEM_DE_FSCRYPT_POLICY;
 #ifdef DEBUG
 			LOG("version: %u\n", t->th_buf.fep->version);
 #endif
@@ -168,8 +167,10 @@ tar_append_file(TAR *t, const char *realname, const char *savename)
 			bytes_to_hex(descriptor, size, policy_hex);
 			if (lookup_ref_key(t->th_buf.fep,  &tar_policy[0])) {
 				if (strncmp((char *) tar_policy, user_ce, sizeof(user_ce) - 1) == 0 
-				|| strncmp((char *) tar_policy, user_de, sizeof(user_de) - 1) == 0 
-				|| strncmp((char *) tar_policy, system_de, sizeof(system_de)) == 0) {
+				|| strncmp((char *) tar_policy, user_de, sizeof(user_de) - 1) == 0
+				|| strncmp((char *) tar_policy, system_de,
+						sizeof(system_de) - 1) == 0) {
 					memcpy(descriptor, tar_policy, size);
 					LOG("found fscrypt policy '%s' - '%s' - '%s'\n", realname, descriptor, policy_hex);
 				} else {
diff --git a/libtar/extract.c b/libtar/extract.c
index 15127ab..5b13c62 100644
--- a/libtar/extract.c
+++ b/libtar/extract.c
@@ -570,7 +570,7 @@ tar_extract_dir(TAR *t, const char *realname)
 		uint8_t binary_policy[size];
 		memset(&binary_policy, 0, size);
 
-		if (!lookup_ref_tar(t->th_buf.fep, &binary_policy[0])) {
+		if (!lookup_ref_tar(descriptor, &binary_policy[0])) {
 			LOG("error looking up fscrypt policy for '%s' - %s\n", realname, descriptor);
 			policy_lookup_error = true;
 		}
diff --git a/libtar/libtar.h b/libtar/libtar.h
index 7447ad5..ac4b15f 100644
--- a/libtar/libtar.h
+++ b/libtar/libtar.h
@@ -12,15 +12,55 @@
 #ifndef LIBTAR_H
 #define LIBTAR_H
 
+#include <stdio.h>
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <linux/capability.h>
 #include "tar.h"
 
 #include "libtar_listhash.h"
 
 #ifdef USE_FSCRYPT
 #include "fscrypt_policy.h"
+
+/*
+ * Android 14 vold no longer exports the policy helper accessors used by
+ * TeamWin's libtar. TW_USE_FSCRYPT_POLICY=2 selects fscrypt_policy_v2 for
+ * Samurai QPR2, so keep the compatibility operations local to libtar.
+ */
+static inline uint8_t *get_policy_descriptor(struct fscrypt_policy_v2 *policy)
+{
+	return policy ? policy->master_key_identifier : NULL;
+}
+
+static inline uint8_t get_policy_size(struct fscrypt_policy_v2 *policy, bool hex)
+{
+	if (!policy)
+		return 0;
+	return hex ? FSCRYPT_KEY_IDENTIFIER_HEX_SIZE : FSCRYPT_KEY_IDENTIFIER_SIZE;
+}
+
+static inline void *get_policy(const struct fscrypt_policy_v2 *policy)
+{
+	return (void *)policy;
+}
+
+static inline int fscrypt_policy_size(const struct fscrypt_policy_v2 *policy)
+{
+	return policy ? (int)sizeof(*policy) : 0;
+}
+
+static inline void get_policy_content(struct fscrypt_policy_v2 *policy,
+		char *content)
+{
+	if (!policy || !content)
+		return;
+	snprintf(content, 50, "%u %u %u %u",
+		(unsigned int)policy->version,
+		(unsigned int)policy->contents_encryption_mode,
+		(unsigned int)policy->filenames_encryption_mode,
+		(unsigned int)policy->flags);
+}
 #endif
 
 #ifdef __cplusplus
-- 
2.43.0
